<div
  class="bundle-item"
  data-bundle-item="{{ item_number }}"
>
  {% for option in product.options_with_values %}
    <div class="bundle-item__option">
      <label class="visually-hidden" for="bundle-{{ block_id }}-option-{{ option.position }}">
        {{ option.name }}
      </label>

      <select
        id="bundle-{{ block_id }}-option-{{ option.position }}"
        data-variant-option
        data-option-position="{{ option.position }}"
      >
        <option value="" selected disabled>
          Select {{ option.name }}
        </option>

        {% for value in option.values %}
          <option value="{{ value | escape }}">
            {{ value }}
          </option>
        {% endfor %}
      </select>
    </div>
  {% endfor %}
</div>
