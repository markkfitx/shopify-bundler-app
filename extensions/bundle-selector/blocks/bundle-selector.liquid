{% comment %}
  Theme app extension block: lets shoppers pick a Single/Duo/Trio bundle
  of the current product's variants, then add those items to the cart.
{% endcomment %}
<div class="bundle-selector">
    <h1>{{ product.title | escape }}</h1>
    <p>From {{ product.price | money }}</p>

    <fieldset class="bundle-form__input">
        <legend class="visually-hideen">Select bundle for {{ product.title | escape }}</legend>

        {% comment %} Bundle size radios: 1 = Single, 2 = Duo, 3 = Trio {% endcomment %}
        {% for item in (1..3) %}
            <div class="bundle-option">
                <input
                    type="radio"
                    name="bundle"
                    id="bundle-quantity-{{ block.id }}-{{ item }}"
                    class="bundle-selector-input"
                    data-bundle-quantity
                    value="{{ item }}"
                    {% if item == 1 %}checked{% endif %}
                >
                <label for="bundle-quantity-{{ block.id }}-{{ item }}">
                    <span>
                        {% case item %}
                            {% when 1 %}Single
                            {% when 2 %}Duo
                            {% when 3 %}Trio
                        {% endcase %}
                    </span>
                </label>
                {% comment %}
                One variant dropdown per possible bundle slot.
                Slots beyond the selected size are hidden/disabled by JS.
                {% endcomment %}
                 <div class="bundle-option__content">
                    {% for item_number in (1..item) %}
                        {% render "variant-selector",
                            product: product,
                            item_number: item_number,
                            bundle_quantity: item,
                            block_id: block.id
                        %}
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </fieldset>

    <div class="bundle-selector-footer">
        {% comment %} data-bundle-add-to-cart is the hook used by bundle-selector.js {% endcomment %}
        <button type="buton" class="button" data-bundle-add-to-cart>Add to cart</button>
        <p data-bundle-message role="status"></p>
    </div>
</div>

{% schema %}
{
  "name": "Bundle Selector",
  "target": "section",
  "javascript": "bundle-selector.js",
  "stylesheet": "base.css",
  "enabled_on": {
    "templates": ["product"],
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bundle and save"
    }
  ]
}
{% endschema %}
