<div class="bundle-selector">
    <h1>{{ product.title | escape }}</h1>
    <p>From {{ product.price | money }}</p>

    <fieldset>
        <legend>Select bundle for {{ product.title | escape }}</legend>
        {%  for quantity in (1..3) %}
            <label>
                <input type="radio" name="bundle" id="bundle-quantity-{{ block.id }}" data-bundle-quantity value="{{ quantity }}" {% if product.selected_or_first_available_variant.quantity == 1 %}checked{% endif %}>
                <span>
                    {%  case quantity %}
                        {% when 1 %}Single
                        {% when 2 %}Duo
                        {% when 3 %}Trio
                    {% endcase %}
                </span>
            </label>
        {% endfor %}
        {% for item_number in (1..3) %}
            <div
            data-bundle-item="{{ item_number }}" {% if item_number > 1 %}hidden{% endif %}>
            <label for="bundle-variant-{{ block.id }}-{{ item_number }}">
                Item {{ item_number }}
            </label>
        
            <select
                id="bundle-variant-{{ block.id }}-{{ item_number }}" {% if item_number > 1 %}disabled{% endif %}>
                <option value="" selected disabled>Choose a variant</option>
        
                {% for variant in product.variants %}
                <option
                    value="{{ variant.id }}"
                    {% unless variant.available %}disabled{% endunless %}
                >
                    {{ variant.title | escape }}
                    {% unless variant.available %} — Sold out{% endunless %}
                </option>
                {% endfor %}
            </select>
            </div>
        {% endfor %}
    </fieldset>
    <div class="bundle-selector-footer">
        <button type="buton" class="button" data-bundle-add-to-cart>Add to cart</button>
        <p data-bundle-message role="status"></p>
    </div>
</div>
{% schema %}
{
  "name": "Bundle Selector",
  "target": "section",
  "javascript": "bundle-selector.js",
  "enabled_on": {
    "templates": ["product"],
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bundle and save"
    }
  ]
}
{% endschema %}